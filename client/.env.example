# Copy to .env.local (ignored by git) and change as needed.
# Vite builds VITE_ variables into the public JavaScript, so never put a
# secret here.

# true: answer from src/mocks/trackingData.js, no API needed.
# Anything else: call the API at VITE_API_BASE_URL.
VITE_USE_MOCK=true

# The API's origin, without /api. Locally this is the "http" profile in
# server/DeliveryTracking.Api/Properties/launchSettings.json.
VITE_API_BASE_URL=http://localhost:5266
